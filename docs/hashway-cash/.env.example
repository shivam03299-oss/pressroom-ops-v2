# ── Hashway Cash Command Center ─────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. All belong to the DEDICATED finance Supabase
# project (not the pressroom one).

# Server (API, private)
CASH_DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
CASH_SUPABASE_URL=https://<ref>.supabase.co
CASH_SUPABASE_ANON_KEY=<anon key — used only to verify user tokens>
CASH_SUPABASE_SERVICE_ROLE_KEY=<optional — only needed to send invite emails from Settings → Users>
CASH_APP_URL=https://pressroom-drab.vercel.app/cash
CASH_SLACK_WEBHOOK_URL=<optional — Slack incoming webhook for the 10 AM reminder + alerts>
CRON_SECRET=<already set for the existing daily-brief cron; reused>
# CASH_DB_POOL_MAX=5   # optional

# Browser (public by design — Row Level Security blocks direct table access)
VITE_CASH_SUPABASE_URL=https://<ref>.supabase.co
VITE_CASH_SUPABASE_ANON_KEY=<anon key>
