{
  "redirects": [
    { "source": "/catalogue", "destination": "/catalog", "permanent": false },
    { "source": "/catalogue/:path*", "destination": "/catalog/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/:path*",   "destination": "/index.html" },
    { "source": "/portal/:path*",  "destination": "/index.html" },
    { "source": "/catalog",        "destination": "/index.html" },
    { "source": "/catalog/:path*", "destination": "/index.html" },
    { "source": "/enquire",        "destination": "/index.html" },
    { "source": "/bulk-orders",    "destination": "/index.html" },
    { "source": "/dtf",            "destination": "/index.html" },
    { "source": "/embroidery",     "destination": "/index.html" },
    { "source": "/fulfillment",    "destination": "/index.html" },
    { "source": "/fulfilment",     "destination": "/index.html" },
    { "source": "/process",        "destination": "/index.html" },
    { "source": "/why",            "destination": "/index.html" },
    { "source": "/compare",        "destination": "/index.html" },
    { "source": "/terms",          "destination": "/index.html" },
    { "source": "/privacy",        "destination": "/index.html" },
    { "source": "/contact-us",     "destination": "/index.html" },
    { "source": "/api/shopify-connect",         "destination": "/api/shopify?action=connect" },
    { "source": "/api/shopify-disconnect",      "destination": "/api/shopify?action=disconnect" },
    { "source": "/api/shopify-status",          "destination": "/api/shopify?action=status" },
    { "source": "/api/shopify-sync",            "destination": "/api/shopify?action=sync" },
    { "source": "/api/shopify-oauth-install",   "destination": "/api/shopify?action=oauth-install" },
    { "source": "/api/shopify-oauth-callback",  "destination": "/api/shopify?action=oauth-callback" },
    { "source": "/api/shopify-admin-install",   "destination": "/api/shopify?action=admin-install" },

    { "source": "/api/hashway-ops-agents",          "destination": "/api/hashway-ops?endpoint=agents" },
    { "source": "/api/hashway-ops-tasks",           "destination": "/api/hashway-ops?endpoint=tasks" },
    { "source": "/api/hashway-ops-execute",         "destination": "/api/hashway-ops?endpoint=execute" },
    { "source": "/api/hashway-ops-run-agent",       "destination": "/api/hashway-ops?endpoint=run-agent" },
    { "source": "/api/hashway-ops-daily-brief",     "destination": "/api/hashway-ops?endpoint=daily-brief" },
    { "source": "/api/hashway-ops-test-connection", "destination": "/api/hashway-ops?endpoint=test-connection" },
    { "source": "/api/hashway-ops-render-image",    "destination": "/api/hashway-ops?endpoint=render-image" },
    { "source": "/api/hashway-ops-finance",         "destination": "/api/hashway-ops?endpoint=finance" },
    { "source": "/api/hashway-ops-delhivery",       "destination": "/api/hashway-ops?endpoint=delhivery" },

    { "source": "/api/hashway-wa-send",    "destination": "/api/hashway-wa?endpoint=send" },
    { "source": "/api/hashway-wa-webhook", "destination": "/api/hashway-wa?endpoint=webhook" },

    { "source": "/api/velocity-track",     "destination": "/api/velocity?action=track" },

    { "source": "/api/shopify-autosync",   "destination": "/api/shopify?action=autosync" },
    { "source": "/api/hashway-orders",      "destination": "/api/shopify?action=hashway-orders" },

    { "source": "/api/hashway-2hr-verify",  "destination": "/api/hashway-2hr-payments?action=verify"  },
    { "source": "/api/hashway-2hr-webhook", "destination": "/api/hashway-2hr-payments?action=webhook" },
    { "source": "/api/velocity-sync",      "destination": "/api/velocity?action=sync" }
  ],
  "crons": [
    {
      "path": "/api/hashway-ops?endpoint=daily-brief",
      "schedule": "30 3 * * *"
    }
  ]
}
